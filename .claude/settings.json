{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git push)",
      "Bash(git add)",
      "Bash(git commit)",
      "Bash(git checkout)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/sync-image-map.js || true",
            "statusMessage": "Új dínóképek szinkronizálása az imageMap.js-hez..."
          }
        ]
      }
    ]
  }
}
